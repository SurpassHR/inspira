# Inspira 环境变量模板
# 使用：cp .env.example .env 后按需修改（.env 已被 .gitignore，不会误提交密钥）。
#
# 约定：
#   · 应用启动时只读取项目根 .env 一次（src/env.ts）；进程里已存在的环境变量优先，
#     不会被 .env 覆盖（systemd / CI 注入的变量无需在此重复）。
#   · 行格式 KEY=VALUE；值可用单/双引号包裹；不支持 $ 变量展开；# 开头为注释。
#   · 留空 = 使用注释里的默认值（config.ts 的 zod 兜底）。
#
# 注：历史版本模板曾误带真实示例密钥（sk-000530 / 个人中转地址），已移除；
# 模板内一律使用占位符与官方默认值，密钥请自行填写。

# ===== HTTP =====
# 服务监听端口
PORT=8787

# ===== 生成调度与存储 =====
# 首次启动的默认自动生成间隔（分钟）；后台「生成设置」可改并持久化
DEFAULT_INTERVAL_MINUTES=60
# 日志/统计展示时区
APP_TIME_ZONE=Asia/Shanghai
# 持久化目录（settings.json / inspirations.json / llm.json / scrape.json / auth.json / audit.jsonl / images/）
DATA_DIR=data
# 失败（error）灵感记录自动清理：0=失败后立即清除；>0=保留 N 小时后清除（默认 24h）
FAILED_RETENTION_HOURS=24

# ===== LLM（点子 / 提示词链路；后台「LLM 配置」提供商优先于这里） =====
# OpenAI 兼容 Chat Completions 入口（官方 / 中转 Base URL）
LLM_BASE_URL=https://api.openai.com/v1
# 密钥。推荐在后台「LLM 配置」添加提供商（可多提供商 + 任务级模型分配）；留空则后台配置优先。
# 模板内不放示例密钥——首次部署请自行填入
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 单次请求超时（自动重试一次）
LLM_TIMEOUT_MS=60000
# 采样温度 / 输出上限
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=2000
# 若报「unable to verify the first certificate」（自签名/代理/中转证书）：
#   A. NODE_OPTIONS=--use-system-ca 前缀启动（证书链到系统根 CA 时，Node ≥ 20.19/22.17）
#   B. 自签名时导出端点证书为 PEM：NODE_EXTRA_CA_CERTS=llm-ca.pem 前缀启动（证书放项目目录之外）
#   C. 完全信任端点时：NODE_TLS_REJECT_UNAUTHORIZED=0 前缀启动（绕过校验，勿用于不可信网络）
#   详见 README「常见问题」；一键修复：npm run fix-llm-ca

# ===== 生图（图像灵感封面；仅后台「模型分配 → 生图」指定模型时启用，环境变量不参与） =====
# images/generations 单次请求超时
LLM_IMAGE_TIMEOUT_MS=180000
# 生图 chat 兜底（流式）总预算：慢速图像模型经中转流式等待的上限（单张 24 分钟级场景需 30min）
LLM_IMAGE_CHAT_TIMEOUT_MS=1800000
# 生图 chat 兜底（流式）空闲看门狗：超过该时长无任何数据（含心跳）即判死；
# 须大于中转心跳间隔（如 flow2api 每 ≤15s）、小于前置 CDN 空闲上限（如 Cloudflare 100s）
LLM_IMAGE_CHAT_IDLE_MS=90000
# 封面生图失败自动重试：检查间隔（分钟，兼作指数退避基准 15→30→60…上限 1h）、
# 轮内相邻两张等待（秒，0=不等待）、单条最大尝试次数（0=不限）
COVER_RETRY_INTERVAL_MINUTES=15
COVER_RETRY_DELAY_SECONDS=30
COVER_RETRY_MAX_ATTEMPTS=6

# ===== 灵感来源：自定义热点 / 热图 JSON 源（可选） =====
# 热点源：JSON 数组 {title, summary?, url?}（兼容 {items:[...]} / {data:[...]}）；
# 未配置时内置默认使用 GitHub 近 7 天热门仓库
HOT_TOPICS_URL=
# 热图源：JSON 数组 {imageUrl, title?, url?}，合入聚合器（provider custom）
HOT_IMAGES_URL=

# ===== 图像聚合抓取（内置 provider） =====
# 逗号分隔白名单，顺序即尝试顺序；google/x/rule34 默认不启用（见 README ToS 说明）
IMAGE_SCRAPE_PROVIDERS=wikimedia,bing,openverse,custom
# 单个 provider 抓取超时
SCRAPE_TIMEOUT_MS=15000
# 图像源失败后的冷却期（毫秒）：冷却期内跳过该源；0=禁用冷却
SCRAPE_FAIL_COOLDOWN_MS=300000
# X（Twitter）图片素材：OAuth2 Bearer Token（付费层级），配置后把 x 加入白名单
X_BEARER_TOKEN=
# Rule34 官方 API 鉴权：两者齐备且白名单含 rule34 才启用
RULE34_API_KEY=
RULE34_USER_ID=

# ===== 后台管理 =====
# 会话有效期（小时）：Cookie 到期需重新登录；服务重启也会清空全部会话
SESSION_TTL_HOURS=168
# 可选：首次启动（data/auth.json 尚无任何用户时）自动种子创建管理员；
# 密码至少 8 位；留空则访问 /admin/setup 页面创建首个管理员。请勿使用弱密码
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== 运行模式（可选） =====
# 生产模式会关闭开发热重载（/__livereload）。systemd 部署时由 unit 的
# Environment=NODE_ENV=production 注入，无需写在这里；开发时保持注释即可。
# NODE_ENV=production