# Inspira 灵感生成器环境变量示例（复制为 .env 后按需修改）

# HTTP 服务
PORT=8787

# LLM（OpenAI 兼容接口，支持任意 Base URL）
LLM_BASE_URL=https://jp.hrfuqiang.top/v1
LLM_API_KEY=sk-000530
LLM_MODEL=gemini-3.7-flash-high
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=2000
# 若连接报「unable to verify the first certificate」（自签名/代理证书）：
#   A. NODE_OPTIONS=--use-system-ca 前缀启动（证书链到系统根 CA 时，Node ≥ 20.19/22.17）
#   B. 自签名时导出端点证书：openssl s_client -connect 域名:443 -showcerts </dev/null 2>/dev/null | openssl x509 -outform PEM > llm-ca.pem
#      再 NODE_EXTRA_CA_CERTS=llm-ca.pem 前缀启动
#   C. 完全信任端点时：NODE_TLS_REJECT_UNAUTHORIZED=0 前缀启动（绕过校验，勿用于不可信网络）
# 详见 README「常见问题」。

# 灵感来源数据源
# 热点：返回 JSON 数组，元素含 title / summary? / url?（兼容 GitHub Search API {items:[...]} 与 {data:[...]}）
# 未配置时内置默认使用 GitHub 近 7 天热门仓库
# HOT_TOPICS_URL=
# 热图：返回 JSON 数组，元素含 imageUrl / title? / url?
# HOT_IMAGES_URL=

# 图像聚合抓取（内置 provider：wikimedia/bing/openverse/google/custom/x）
# 逗号分隔白名单，顺序即尝试顺序；google 常被反爬（默认不开），x 需 Token（默认不开）
IMAGE_SCRAPE_PROVIDERS=wikimedia,bing,openverse,custom
SCRAPE_TIMEOUT_MS=8000
# 图像源失败后的冷却期（毫秒）：冷却期内跳过该源，避免定时任务反复空等超时；0=禁用冷却
SCRAPE_FAIL_COOLDOWN_MS=300000
# X（Twitter）OAuth2 Bearer Token（付费层级），配置后需把 x 加入 IMAGE_SCRAPE_PROVIDERS
X_BEARER_TOKEN=

# 默认设置（首次启动写入 data/settings.json）
DEFAULT_INTERVAL_MINUTES=60
DATA_DIR=data

# 失败（error）灵感记录自动清理：0=失败后立即清除（默认）；>0=保留 N 小时后清除（如 24）
FAILED_RETENTION_HOURS=0